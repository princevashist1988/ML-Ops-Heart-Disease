          },
          "expr": "sum by (endpoint) (rate(heartrisk_validation_errors_total[1m])) * 60",
          "legendFormat": "{{endpoint}}",
          "refId": "Q",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,

# environments
.venv/
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# raw downloads are reproducible via `make data` (cleaned CSVs ARE committed)
data/raw/*
!data/raw/.gitkeep

# MLflow local store is a CI artifact; the final model package IS committed
mlflow.db
mlartifacts/
mlruns/

# local logs (CI uploads its own)
logs/*.log
image.tar*

!logs/.gitkeep
